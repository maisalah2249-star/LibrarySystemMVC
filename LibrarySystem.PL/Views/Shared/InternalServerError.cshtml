@{
    ViewData["Title"] = "Server Error";
}

<div class="error-page text-center">
    <div class="error-page__code display-1">500</div>
    <h1 class="display-5">Something went wrong</h1>
    <p class="lead text-muted">An unexpected error occurred while processing your request. Please try again later.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return Home</a>
</div>