@model Author
@{
    ViewData["Title"] = "Create Author";
}

<h1>Create new Author</h1>

<form asp-action="Create">
    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
    <div class="form-group">
        <label asp-for="Code"></label>
        <input class="form-control" asp-for="Code" />
        <span class="text-danger" asp-validation-for="Code"></span>
    </div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="form-group">
        <label asp-for="DateOfBirth"></label>
        <input class="form-control" asp-for="DateOfBirth" />
        <span class="text-danger" asp-validation-for="DateOfBirth"></span>
    </div>

    <div class="mt-3">
        <button class="btn btn-success" type="submit">Create</button>
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}