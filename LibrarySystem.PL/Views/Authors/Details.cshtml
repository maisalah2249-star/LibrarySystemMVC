@model Author
@{
    ViewData["Title"] = "Author Details";
}

<h1>@Model.Name Details</h1>

<div class="form-group">
    <label asp-for="Code"></label>
    <input readonly class="form-control" asp-for="Code" />
</div>
<div class="form-group">
    <label asp-for="Name"></label>
    <input readonly class="form-control" asp-for="Name" />
</div>
<div class="form-group">
    <label asp-for="DateOfBirth"></label>
    <input readonly class="form-control" asp-for="DateOfBirth" />
</div>

<div class="mt-3">
    <a class="btn btn-info" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</div>