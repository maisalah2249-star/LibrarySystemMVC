@model BookViewModel

@if (!string.IsNullOrEmpty(Model.ImageName))
{
    <div class="mb-3">
        <img src="~/Files/Images/@Model.ImageName" class="img-thumbnail" style="max-width:200px" alt="Book cover" />
    </div>
}

<div class="form-group">
    <label asp-for="Title"></label>
    <input readonly class="form-control" asp-for="Title" />
</div>
<div class="form-group">
    <label asp-for="ISBN"></label>
    <input readonly class="form-control" asp-for="ISBN" />
</div>
<div class="form-group">
    <label asp-for="Description"></label>
    <textarea readonly class="form-control" asp-for="Description" rows="3"></textarea>
</div>
<div class="form-group">
    <label>Author</label>
    <input readonly class="form-control" value="@Model.Author?.Name" />
</div>
<div class="form-group">
    <label asp-for="Price"></label>
    <input readonly class="form-control" asp-for="Price" />
</div>
<div class="form-group">
    <label asp-for="NumberOfPages"></label>
    <input readonly class="form-control" asp-for="NumberOfPages" />
</div>
<div class="form-group mt-2">
    <label asp-for="IsAvailable"></label>
    <input readonly disabled asp-for="IsAvailable" />
</div>