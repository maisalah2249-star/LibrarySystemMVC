@model PaginatedList<BookViewModel>
@{
    ViewData["Title"] = "Books";
}

<a asp-action="Create" class="btn btn-primary mt-3">Create New Book</a>

<div class="mt-3 container">
    <form asp-action="Index" method="get" class="row">
        <div class="col-8 col-md-6">
            <input class="form-control" placeholder="Book Title" name="searchValue" value="@Context.Request.Query["searchValue"]" />
        </div>
        <div class="col-4">
            <input type="submit" class="btn btn-info" value="Search" />
        </div>
    </form>
</div>

@if (Model.Any())
{
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <td>Cover</td>
                <td>Title</td>
                <td>ISBN</td>
                <td>Author</td>
                <td>Price</td>
                <td>Pages</td>
                <td>Available</td>
                <td>Details</td>
                <td>Edit</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(book.ImageName))
                        {
                            <img src="~/Files/Images/@book.ImageName" class="rounded" style="width:60px" alt="cover" />
                        }
                    </td>
                    <td>@book.Title</td>
                    <td>@book.ISBN</td>
                    <td>@book.Author?.Name</td>
                    <td>@Html.DisplayFor(b => book.Price)</td>
                    <td>@book.NumberOfPages</td>
                    <td>
                        @if (book.IsAvailable)
                        {
                            <i class="fa-solid fa-circle" style="color:green"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle" style="color:red"></i>
                        }
                    </td>
                    <partial name="_ButtonsPartial" model="@book.Id" />
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Book pages">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-warning mt-5">
        <h2>No Books</h2>
    </div>
}